{
  "id": "demo_np2",
  "name": "NumPy 2 示例（依赖隔离验证）",
  "type": "Python",
  "entry": "main.py",
  "python_version": "3.12",
  "ui_mode": "stdio",
  "load_mode": "always",
  "permissions": [],
  "dependencies": [
    { "path": "requirements.txt", "manager": "uv", "explicit": false }
  ],
  "commands": [
    { "name": "/npversion", "desc": "返回本插件隔离环境中的 NumPy 版本", "method": "npversion" }
  ],
  "functions": [
    { "name": "np2.version", "method": "npversion", "desc": "demo_np2 的 numpy 版本" }
  ]
}