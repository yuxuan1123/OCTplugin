{
  "id": "translation",
  "name": "翻译",
  "version": "2.0.0",
  "type": "Python",
  "entry": "main.py",
  "python_version": "3.12",
  "ui": { "type": "web", "entry": "ui/index.html" },
  "load_mode": "always",
  "permissions": ["net", "file_read", "file_write"],
  "dependencies": [
    { "path": "requirements.txt", "manager": "uv", "explicit": false }
  ],
  "commands": [],
  "functions": [
    { "name": "translation.ping", "method": "ping", "desc": "翻译桥连通性" },
    { "name": "translation.langs", "method": "translation.langs", "desc": "支持的语种列表" },
    { "name": "translation.directions", "method": "translation.directions", "desc": "翻译方向列表（auto/zh2en/en2zh）" },
    { "name": "translation.translate", "method": "translation.translate", "desc": "文本翻译（hy/opusmt 本地引擎）" },
    { "name": "translation.engine.get", "method": "translation.engine.get", "desc": "当前翻译引擎" },
    { "name": "translation.engine.set", "method": "translation.engine.set", "desc": "切换翻译引擎并持久化" },
    { "name": "translation.engine.installhy", "method": "translation.engine.installhy", "desc": "按需安装 Hy 引擎运行依赖（llama-cpp-python，后台编译）" },
    { "name": "translation.config.get", "method": "translation.config.get", "desc": "读取翻译配置" },
    { "name": "translation.config.set", "method": "translation.config.set", "desc": "更新翻译配置并持久化" },
    { "name": "translation.models.status", "method": "translation.models.status", "desc": "各子系统模型缺失预警" },
    { "name": "translation.app.start", "method": "translation.app.start", "desc": "启动指定实时应用（屏幕OCR/屏幕翻译/实时翻译/屏幕字幕/语音翻译）" },
    { "name": "translation.app.stop", "method": "translation.app.stop", "desc": "停止指定应用" },
    { "name": "translation.app.toggle", "method": "translation.app.toggle", "desc": "启动⇄停止切换" },
    { "name": "translation.app.status", "method": "translation.app.status", "desc": "全部应用运行状态" },
    { "name": "translation.app.region", "method": "translation.app.region", "desc": "触发原生全屏框选区域" },
    { "name": "translation.app.set_region", "method": "translation.app.set_region", "desc": "预置固定截图区域" },
    { "name": "translation.logs", "method": "translation.logs", "desc": "日志缓存" },
    { "name": "translation.preload", "method": "translation.preload", "desc": "后台预加载模型" }
  ]
}